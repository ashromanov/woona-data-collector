POSTGRES_DB=woona
POSTGRES_USER=woona
POSTGRES_PASSWORD=woona-local-only
WOONA_DEVICE_ID=00000000-0000-0000-0000-000000000001
WOONA_DEVICE_LABEL=Local device
WOONA_DEBUG_TOKEN=change-me-local-token
WOONA_ALLOW_LEGACY_MIGRATION=true
WOONA_API_PORT=8080
WOONA_STORAGE_ROOT_HOST=../var/storage
# Set an absolute path to keep PostgreSQL in a local folder instead of a Docker volume.
# WOONA_POSTGRES_ROOT=/absolute/path/to/var/postgres
